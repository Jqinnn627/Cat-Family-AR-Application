<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Quiz" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); background-image: url(&apos;project://database/Assets/image/MainMenu/bg.jpg?fileID=2800000&amp;guid=64454be885df8e1498310dc9ebd0ff5e&amp;type=3#bg&apos;);">
        <ui:VisualElement name="QuestionContainer" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
            <ui:Label tabindex="-1" text="Label" display-tooltip-when-elided="true" name="question-text" style="-unity-text-align: upper-center; font-size: 40%;" />
        </ui:VisualElement>
        <ui:VisualElement name="AnswerContainer" style="flex-grow: 1; background-color: rgba(255, 97, 97, 0); height: 0; flex-direction: row;">
            <ui:Button text="Yes" display-tooltip-when-elided="true" name="yes-button" style="width: 45%; height: 80%; margin-left: 1%; margin-right: 2%; font-size: 30%;" />
            <ui:Button text="No" display-tooltip-when-elided="true" name="no-button" style="width: 45%; height: 80%; margin-left: 2%; margin-right: 1%; font-size: 30%;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
