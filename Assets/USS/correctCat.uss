.indicator {
    position: absolute;
    top: 0;
    left: 0;
    width: 150px;
    height: 150px;
    opacity: 0;
    display: none;
    picking-mode: Ignore;
}

#correct-indicator {
    background-image: url('project://database/Assets/image/good.jpg?fileID=2800000&guid=86cdc76fbb6df8a4e8d679a3ef6e5004&type=3#good');
    position: absolute;
    display: none;
}

#wrong-indicator {
    background-image: url('project://database/Assets/image/cat-cats.gif?fileID=2800000&guid=940e420a1a502a644b74fb9b129f59be&type=3#cat-cats');
    position: absolute;
    display: none;
}

.unity-progress-bar {
    width: 80%;
    height: 1%;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}
